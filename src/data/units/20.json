        { "zh": "请问，你 叫 什么 名字？", "p": "Qǐngwèn, nǐ jiào shénme míngzi?", "m": "실례지만, 이름이 뭐예요?" },
        { "zh": "请 告诉 我 你 的 电话。", "p": "Qǐng gàosu wǒ nǐ de diànhuà.", "m": "전화번호 좀 알려 주세요." }
      ]
    },
    {
