  "sentences": [
    { "zh": "请进，请坐，请 喝 茶！", "p": "Qǐngjìn, qǐngzuò, qǐng hē chá!", "m": "들어오세요, 앉으세요, 차 드세요!" },
    { "zh": "请问，洗手间 在 哪儿？", "p": "Qǐngwèn, xǐshǒujiān zài nǎr?", "m": "실례지만, 화장실이 어디예요?" },
    { "zh": "太 冷 了，关上 门 吧。", "p": "Tài lěng le, guānshang mén ba.", "m": "너무 추워요, 문 닫읍시다." },
    { "zh": "我们 出去 吃饭 吧。", "p": "Wǒmen chūqu chīfàn ba.", "m": "우리 나가서 밥 먹자." },
    { "zh": "请 打开 书，看 第 十 页。", "p": "Qǐng dǎkāi shū, kàn dì shí yè.", "m": "책을 펴고 10쪽을 보세요." },
    { "zh": "他 在 门口 等 你 吧？", "p": "Tā zài ménkǒu děng nǐ ba?", "m": "그 사람 문 앞에서 너 기다리고 있지?" },
    { "zh": "我 送 你 回家 吧。", "p": "Wǒ sòng nǐ huíjiā ba.", "m": "내가 집까지 바래다줄게." },
    { "zh": "我 给 你 介绍 我 的 朋友。", "p": "Wǒ gěi nǐ jièshào wǒ de péngyou.", "m": "내 친구를 소개해 줄게." }
